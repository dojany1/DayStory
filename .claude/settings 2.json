{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/check-pending-phases.mjs",
            "timeout": 10,
            "statusMessage": "Checking pending harness phases..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/session-checkpoint.ps1",
            "timeout": 120,
            "statusMessage": "Saving session checkpoint to GitHub..."
          }
        ]
      }
    ]
  }
}
