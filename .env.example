# DayStory — 환경 변수 예시
# =====================================================================
# 이 파일을 `.env` 로 복사한 뒤 실제 값을 채워 넣으세요.
# `.env` 는 `.gitignore` 에 등록되어 있으므로 커밋되지 않습니다.
# =====================================================================

# --- Firebase ---
# 비워두면 `src/js/firebase.js` 의 dokhu-daystory 폴백 설정이 사용됩니다.
# 별도 프로젝트로 운영하려면 아래 값을 채우세요.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# --- 카카오톡 공유 (Wave 6) ---
# 카카오 개발자 콘솔(https://developers.kakao.com)에서:
#   1) 내 애플리케이션 → 앱 생성
#   2) 플랫폼 → Web 추가 → 사이트 도메인 등록 (예: https://daystory.app)
#   3) 앱 키 → "JavaScript 키" 복사해서 아래에 붙여넣기
#   4) 카카오 로그인 / 메시지 템플릿은 사용 안 함 (sendDefault feed 만 사용)
#
# 이 키가 비어 있으면 카카오톡 공유 호출은 일반 공유 시트로 자동 폴백합니다.
VITE_KAKAO_APP_KEY=
