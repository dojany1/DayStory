<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: https://dokhu-daystory.web.app/share* 를 앱에서 직접 연다.
                 autoVerify + /.well-known/assetlinks.json 으로 도메인 소유를 검증한다. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="dokhu-daystory.web.app"
                    android:pathPrefix="/share" />
            </intent-filter>

            <!-- 커스텀 스킴: 카카오톡 등 인앱 브라우저는 App Link 를 가로채지 않으므로
                 /share fallback 페이지가 intent://…;scheme=daystory;package=… 로 앱을
                 직접 실행한다. 그 intent 가 이 필터로 들어와 daystory://share… 를 연다. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="daystory" />
            </intent-filter>
        </activity>

        <!-- Google AdMob 앱 ID.
             주의: 광고 "단위" ID(ca-app-pub-…/…) 가 아니라 "앱" ID(ca-app-pub-…~…) 다.
             이 값이 없거나 형식이 틀리면 앱이 실행 즉시 크래시한다.
             개발 중에도 이 값은 실제 앱 ID 를 쓴다 (Google 권장).
             테스트 광고 여부는 ads.js 의 USE_TEST_ADS 가 광고 "단위" 레벨에서 제어한다. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3250744272484684~3073922259" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AdMob 광고 ID(GAID) 접근 — targetSdk 33+ 에서는 명시하지 않으면
         광고 ID 를 받지 못해 타게팅/수익이 떨어진다. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
</manifest>
