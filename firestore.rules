rules_version = '2';

// DayStory Firestore Security Rules — v1.5.0 (audit 3-2)
// =====================================================================
// 핵심 원칙:
//   1) 모든 read/write 는 로그인 필수 (게스트 모드 제거, Wave 2).
//   2) profile.role 은 사용자가 직접 바꿀 수 없다 (클라이언트 admin 부여 차단, audit P0).
//   3) 사용자 일기/북마크는 본인만 read/write.
//   4) stories(역사 카드)는 모두 read 가능, write 는 어드민(role == 'editor') 만.
//   5) userStories.update 시 uid 불변 — 소유권 이전·타인 피드 주입 차단 (audit 3-2).
//      bookmarks 는 update 미허용(토글 전용)으로 user_id 변조 원천 차단.
//
// 배포: firebase deploy --only firestore:rules
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 헬퍼 ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'editor';
    }

    // ---------- profiles/{uid} ----------
    // 본인만 read/write. 단, role 필드는 변경 불가 (클라이언트가 자기 자신을 editor 로 승격 차단).
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && (!('role' in request.resource.data) || request.resource.data.role != 'editor');
      allow update: if isOwner(uid)
                    && (
                      // role 미존재 → 미존재 유지 OK
                      (!('role' in resource.data) && !('role' in request.resource.data))
                      // role 존재 → 같은 값만 유지 가능 (사용자가 직접 못 바꿈)
                      || (resource.data.role == request.resource.data.role)
                    );
      allow delete: if isOwner(uid);
    }

    // ---------- stories/{id} — 역사 카드 ----------
    match /stories/{id} {
      // 발행된 카드는 로그인 사용자 누구나 read.
      // 어드민은 모든 status 의 카드 read.
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.status == 'published');
      // 작성/수정/삭제는 어드민만.
      allow create, update, delete: if isAdmin();
    }

    // ---------- userStories/{id} — 내 일기 ----------
    match /userStories/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // update: 본인 문서만. 단 uid 는 불변 —
      // 자기 문서의 uid 를 타인 uid 로 바꿔 남의 피드에 카드를 주입/소유권을 이전하는 것을 차단 (audit 3-2).
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- bookmarks/{id} ----------
    // 북마크는 토글(생성/삭제) 전용. update 를 허용하지 않으므로 user_id 변조(audit 3-2)는 원천 불가.
    match /bookmarks/{id} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      // allow update: 의도적으로 미허용 (기본 거부) — user_id 불변 보장.
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    // ---------- reports/{id} — 오류 신고 (Wave 2 에서 페이지는 유지) ----------
    match /reports/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ---------- notices/{id} — 공통 공지(알림 센터) ----------
    // 로그인 사용자 누구나 read, 작성/수정/삭제는 어드민만.
    match /notices/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---------- inquiries/{id} — 문의/건의 (UGC 신고 뼈대 + 알림 센터) ----------
    // 생성: 본인 명의(userId == 작성자 uid)로만 — 타인 inbox 주입 차단.
    // 조회: 본인 문의는 본인이, 그 외엔 어드민만 (알림 센터에서 본인 답변 열람).
    // 수정/삭제: 어드민만 — 답변(answer/status) 위조 방지(유저는 자기 글도 변경 불가).
    match /inquiries/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---------- 그 외 모든 경로는 기본 거부 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
