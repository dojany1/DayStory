{
  "name": "daystory",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --environment jsdom",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-daystory \"vitest run --config vitest.rules.config.js\"",
    "harness:auto": "node scripts/codex-harness.mjs",
    "harness": "node scripts/codex-harness.mjs",
    "harness:status": "node scripts/codex-harness.mjs --status",
    "harness:commit": "node scripts/harness-commit.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@firebase/rules-unit-testing": "^3.0.4",
    "jsdom": "^29.0.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@capacitor-community/media": "^9.1.0",
    "@capacitor-firebase/authentication": "^8.2.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "cropperjs": "^1.6.2",
    "firebase": "^10.14.1",
    "html2canvas": "^1.4.1",
    "modern-screenshot": "^4.7.0",
    "swiper": "^11.2.10"
  }
}
