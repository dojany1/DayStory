rules_version = '2';

// DayStory Storage Security Rules — v1.4.0 (Wave 4)
// =====================================================================
// 핵심 원칙:
//   1) 로그인 사용자만 업로드 가능 (게스트 폴백 차단, Wave 2 동기화).
//   2) 본인 폴더(users/{uid}/**) 에만 쓰기 가능.
//   3) read 는 인증 사용자라면 누구나(공유 카드 이미지 등) — Firestore Rules 가 데이터 가시성 통제.
//   4) 이미지 MIME 만 허용, 10MB 제한.
//
// 배포: firebase deploy --only storage
// =====================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // 사용자 업로드 디렉토리: users/{uid}/(editor_images|diary|...)/...
    match /users/{userId}/{folder=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024  // 10MB
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // 명시적 차단: 비로그인/익명 'guest' 경로 (v1.3.5 이전 잔재 보호)
    match /users/guest/{path=**} {
      allow read, write: if false;
    }

    // 그 외 경로는 기본 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
